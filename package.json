{
  "name": "hidden_groups",
  "version": "1.0.1",
  "description": "Nextcloud app to keep groups that are only meant for configuration out of sharing",
  "license": "AGPL-3.0-or-later",
  "private": true,
  "scripts": {
    "build": "vite build --mode production",
    "dev": "vite build --mode development",
    "watch": "vite build --mode development --watch",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "stylelint": "stylelint  \"src/**/*.scss\" \"src/**/*.vue\"",
    "stylelint:fix": "stylelint  \"src/**/*.scss\" \"src/**/*.vue\" --fix"
  },
  "type": "module",
  "dependencies": {
    "@nextcloud/axios": "^2.6.0",
    "@nextcloud/dialogs": "^7.5.0",
    "@nextcloud/initial-state": "^3.0.0",
    "@nextcloud/l10n": "^3.4.1",
    "@nextcloud/router": "^3.2.0",
    "@nextcloud/vue": "^9.13.1",
    "vue": "^3.5.43"
  },
  "engines": {
    "node": "^24.0.0",
    "npm": "^11.3.0"
  },
  "devDependencies": {
    "@nextcloud/browserslist-config": "^3.1.2",
    "@nextcloud/eslint-config": "^9.0.1",
    "@nextcloud/stylelint-config": "^3.2.2",
    "@nextcloud/vite-config": "^2.5.4",
    "eslint": "^10.12.0",
    "stylelint": "^17.16.0",
    "vite": "^7.3.7"
  },
  "browserslist": [
    "extends @nextcloud/browserslist-config"
  ]
}
